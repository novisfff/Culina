{
  "name": "culina",
  "private": true,
  "scripts": {
    "db:up": "cd deploy && docker compose up -d mysql minio",
    "db:down": "cd deploy && docker compose down",
    "db:logs": "cd deploy && docker compose logs -f mysql minio",
    "deploy:up": "cd deploy && docker compose up -d --build",
    "deploy:down": "cd deploy && docker compose down",
    "deploy:logs": "cd deploy && docker compose logs -f",
    "deploy:test:smoke-utils": "node --test deploy/tests/media-permission-smoke-utils.test.mjs",
    "deploy:smoke:media": "node deploy/tests/run-media-permission-smoke.mjs",
    "deploy:smoke": "npm run deploy:smoke:media",
    "frontend:install": "npm --prefix frontend install",
    "dev": "npm --prefix frontend run dev --",
    "build": "npm --prefix frontend run build --",
    "preview": "npm --prefix frontend run preview --",
    "test": "npm --prefix frontend run test --",
    "frontend:dev": "npm --prefix frontend run dev --",
    "frontend:build": "npm --prefix frontend run build --",
    "frontend:preview": "npm --prefix frontend run preview --",
    "frontend:test": "npm --prefix frontend run test --",
    "frontend:test:coverage": "npm --prefix frontend run test:coverage --",
    "frontend:e2e:p0": "npm --prefix frontend run e2e:p0 --",
    "frontend:smoke": "npm --prefix frontend run smoke",
    "frontend:typecheck": "npm --prefix frontend run typecheck --",
    "frontend:quality": "npm --prefix frontend run quality --",
    "frontend:governance": "npm --prefix frontend run check:governance --",
    "frontend:audit:prod": "npm audit --prefix frontend --omit=dev --audit-level=high",
    "backend:venv": "python3 -m venv backend/.venv && backend/.venv/bin/pip install -r backend/requirements-dev.txt",
    "backend:init-db": "cd backend && .venv/bin/python scripts/init_mysql.py",
    "backend:migrate": "cd backend && .venv/bin/alembic upgrade head",
    "backend:migrate:smoke": "cd backend && PYTHONPATH=. .venv/bin/python scripts/check_alembic_migrations.py",
    "backend:migrate-media": "cd backend && PYTHONPATH=. .venv/bin/python scripts/migrate_media_to_minio.py",
    "backend:model-usage:health": "cd backend && PYTHONPATH=. .venv/bin/python scripts/maintain_model_usage.py health",
    "backend:model-usage:prices": "cd backend && PYTHONPATH=. .venv/bin/python scripts/manage_model_usage_prices.py",
    "backend:model-usage:send-coverage": "cd backend && PYTHONPATH=. .venv/bin/python scripts/check_model_usage_adapter_coverage.py",
    "backend:prune-ai-trace": "cd backend && .venv/bin/python scripts/prune_ai_trace_records.py",
    "backend:dev": "cd backend && .venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8010 --reload",
    "backend:test": "cd backend && .venv/bin/python -m pytest tests",
    "backend:test:ci-groups": "cd backend && .venv/bin/python scripts/run_ci_test_group.py --check",
    "backend:test:service": "cd backend && .venv/bin/python scripts/run_ci_test_group.py service",
    "backend:test:ai": "cd backend && .venv/bin/python scripts/run_ci_test_group.py ai",
    "backend:test:ai-evals": "cd backend && .venv/bin/python scripts/run_ci_test_group.py ai_evals",
    "backend:test:family-model-settings": "cd backend && .venv/bin/python scripts/run_ci_test_group.py family_model_settings -q",
    "backend:test:model-usage": "cd backend && .venv/bin/python scripts/run_ci_test_group.py model_usage -q",
    "backend:check:ai-evals": "cd backend && .venv/bin/python scripts/check_ai_skill_eval_report.py --report .artifacts/ai-skill-eval-report.json --thresholds ai_eval_thresholds.json --cases tests/ai_evals/cases/core.jsonl",
    "backend:test:search": "cd backend && .venv/bin/python scripts/run_ci_test_group.py search",
    "backend:test:coverage": "cd backend && .venv/bin/python -m pytest tests --cov=app --cov-report=term --cov-report=json:coverage.json",
    "backend:audit:prod": "cd backend && .venv/bin/python -m pip_audit -r requirements.txt",
    "audit:prod": "npm run frontend:audit:prod && npm run backend:audit:prod",
    "backend:typecheck": "cd backend && PYTHONPATH=. .venv/bin/python -m compileall -q app tests",
    "backend:quality": "npm run backend:typecheck && npm run backend:test"
  }
}
