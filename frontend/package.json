{
  "name": "culina-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b --pretty false",
    "build": "tsc -b && vite build --config vite.config.ts && node scripts/check-bundle-budgets.mjs",
    "build:e2e": "vite build --config vite.config.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "coverage:report": "mkdir -p coverage && npm run test:coverage -- --reporter=json --outputFile=coverage/vitest-results.json && node scripts/coverage-topology-report.mjs",
    "e2e:p0": "playwright test --grep @p0",
    "e2e:p0:update": "playwright test --grep @p0 --update-snapshots",
    "smoke": "playwright test e2e/model-usage-governance.spec.mjs",
    "ai:skill-smoke": "node scripts/ai-skill-manual-smoke.mjs",
    "health:report": "node scripts/frontend-health-metrics.mjs",
    "health:test": "vitest run scripts/frontend-health-metrics.test.mjs",
    "health:baseline:check": "node scripts/frontend-health-metrics.mjs --check-baseline scripts/frontend-health-baseline.json",
    "build:manifest": "vite build --config vite.config.ts",
    "manifest:check": "node scripts/bundle-manifest.mjs --check dist/.vite/frontend-health-manifest.json",
    "check:bundle": "node scripts/check-bundle-budgets.mjs --mode=report",
    "check:governance": "node scripts/check-frontend-governance.mjs",
    "check:css-governance": "node scripts/style-contract.mjs",
    "check:css-layers": "node scripts/css-layer-contract.mjs",
    "report:dead-selectors": "node scripts/dead-selectors.mjs",
    "check:style-tokens": "node scripts/check-style-token-drift.mjs",
    "quality": "npm run typecheck && npm run test && npm run check:style-tokens"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.64.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.60.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^2.1.9",
    "jsdom": "^25.0.1",
    "playwright": "^1.60.0",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
