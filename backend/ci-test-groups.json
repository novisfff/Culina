{
  "version": 1,
  "groups": {
    "service": [
      "account",
      "activity",
      "core",
      "deployment",
      "family",
      "inventory",
      "meal_logs",
      "media",
      "recipes",
      "shopping"
    ],
    "ai": [
      "ai_audio",
      "ai_infra",
      "ai_runtime"
    ],
    "ai_evals": [
      "ai_evals"
    ],
    "family_model_settings": [
      "family_model_settings"
    ],
    "model_usage": [
      "model_usage"
    ],
    "search": [
      "search"
    ]
  },
  "mysql_suites": {
    "service-concurrency": { "groups": ["service"], "markers": "mysql" },
    "ai-concurrency": { "groups": ["ai"], "markers": "mysql" },
    "family-model-settings": { "groups": ["family_model_settings"], "markers": "" },
    "model-usage-core": { "groups": ["model_usage"], "markers": "not mysql_reporting" },
    "model-usage-reporting": { "groups": ["model_usage"], "markers": "mysql_reporting" }
  }
}
