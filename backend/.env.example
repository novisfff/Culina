# Culina 后端本地配置示例。
# 直接运行 FastAPI 时复制为 backend/.env；Docker Compose 部署请使用 deploy/.env。

# 运行环境。ENVIRONMENT 常用 local/development/dev/test/testing；其他值按非本地环境做安全校验。
ENVIRONMENT=local
LOG_LEVEL=INFO
FRONTEND_ORIGIN=http://localhost:5173

# MySQL。本地后端配合 npm run db:up 使用时，保持 127.0.0.1。
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=culina
MYSQL_USER=culina
MYSQL_PASSWORD=culina_local_password

# 认证与上传限制。JWT_SECRET 只允许本地开发留空。
JWT_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=10080
MEDIA_MAX_UPLOAD_BYTES=31457280

# MinIO。本地后端使用宿主机映射地址，不使用 Compose 服务名。
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=culina
MINIO_SECRET_KEY=culina_local_minio_secret
MINIO_BUCKET=culina-media
MINIO_SECURE=false

# 初始家庭引导。仅在数据库没有任何用户时生效。
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=CulinaAdmin123!
INITIAL_ADMIN_DISPLAY_NAME=家庭管理员
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PHONE=
INITIAL_FAMILY_NAME=Culina 家庭厨房
INITIAL_FAMILY_MOTTO=
INITIAL_FAMILY_LOCATION=

# AI 追踪与可观测性。除本地排查外，payload 建议保持 redacted。
AI_TRACE_ENABLED=true
AI_TRACE_CAPTURE_LLM_EXCHANGES=false
AI_TRACE_CAPTURE_MESSAGE_CONTENT=false
AI_TRACE_CAPTURE_STREAM_CHUNKS=false
AI_TRACE_CAPTURE_IMAGE_BYTES=false
AI_TRACE_PAYLOAD_MODE=redacted
AI_TRACE_RETENTION_DAYS=7
AI_TRACE_MAX_REQUEST_BYTES=1048576
AI_TRACE_MAX_RESPONSE_BYTES=1048576

# 模型用量治理。生产环境必须启用 required，并配置专用的 receipt HMAC keyring；
# keyring JSON 只放在部署密钥存储中，示例中保持为空以避免复制可用密钥。
MODEL_USAGE_REQUIRED=false
MODEL_USAGE_MAINTENANCE_ENABLED=true
MODEL_USAGE_DEFAULT_HARD_LIMIT=false
MODEL_USAGE_RECEIPT_QUEUE_SIZE=1000
MODEL_USAGE_RECEIPT_INTEGRITY_ACTIVE_KEY_ID=
MODEL_USAGE_RECEIPT_INTEGRITY_KEYS_JSON=
MODEL_USAGE_FAIL_OPEN_PROOF_TTL_SECONDS=5
MODEL_USAGE_SOURCE_INSTANCE=culina-api

# 家庭模型服务的部署安全边界。Provider、模型、价格和 API Key 由家庭 Owner 在“家庭 → AI 服务”配置、验证并发布；
# 旧 Provider 环境变量会被忽略且不会被导入。credential keyring 必须使用独立的 base64 编码 32-byte 密钥，示例不得填入可用密钥。
FAMILY_MODEL_CREDENTIAL_ACTIVE_KEY_ID=
FAMILY_MODEL_CREDENTIAL_KEYS_JSON=
FAMILY_MODEL_REVOKED_SECRET_RETENTION_HOURS=24
FAMILY_MODEL_PRIVATE_TARGET_ALLOWLIST_JSON={"http":[],"websocket":[]}
FAMILY_MODEL_EGRESS_PROXY_URL=
FAMILY_MODEL_PROVIDER_CONNECT_TIMEOUT_SECONDS=10
FAMILY_MODEL_PROVIDER_REQUEST_TIMEOUT_SECONDS=180
FAMILY_MODEL_PROVIDER_RESPONSE_MAX_BYTES=8388608
FAMILY_MODEL_PROVIDER_MEDIA_MAX_BYTES=31457280
FAMILY_MODEL_PROVIDER_REDIRECT_LIMIT=0
FAMILY_MODEL_AUDIO_UPLOAD_MAX_BYTES=10485760
FAMILY_MODEL_STT_MAX_DURATION_SECONDS=60
FAMILY_MODEL_TTS_MAX_CHARACTERS=4096
FAMILY_MODEL_REALTIME_SESSION_MAX_SECONDS=300
FAMILY_MODEL_QDRANT_COLLECTION_PREFIX=culina_fsp
FAMILY_MODEL_RETIRED_COLLECTION_RETENTION_DAYS=7
FAMILY_MODEL_MAINTENANCE_ENABLED=true

# 搜索基础设施。固定关键词后端为 mysql；向量基础设施可使用 qdrant 或 disabled。
SEARCH_HYBRID_ENABLED=true
SEARCH_KEYWORD_BACKEND=mysql
SEARCH_VECTOR_BACKEND=qdrant
# Qdrant。本地后端需要连接 Qdrant 时使用宿主机映射地址。
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_TIMEOUT_SECONDS=10
